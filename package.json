{
  "name": "chat-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:test": "vite --mode test --port 5174 --strictPort",
    "db:start": "npx --yes supabase@2 start -x edge-runtime,studio,imgproxy,logflare,vector,supavisor",
    "db:stop": "npx --yes supabase@2 stop",
    "db:reset": "npx --yes supabase@2 db reset",
    "test:db": "bash scripts/test-db.sh",
    "test:migration": "bash scripts/test-migration.sh",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "build:native": "tsc -b && node scripts/native-bundle.mjs",
    "ios:sync": "npm run build:native && npx cap sync ios",
    "ios:sim": "bash scripts/ios-sim.sh",
    "ios:assets": "node scripts/ios-assets.mjs",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/privacy-screen": "2.0.1",
    "@capacitor/status-bar": "8.0.4",
    "@capgo/capacitor-updater": "8.53.1",
    "@khanacademy/simple-markdown": "^4.0.1",
    "@supabase/supabase-js": "^2.49.0",
    "emojibase-data": "16.0.3",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.7"
  }
}
